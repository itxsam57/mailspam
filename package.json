{
  "name": "email-shield",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": ["server"],
  "scripts": {
    "preflight": "node scripts/engineering/preflight.mjs",
    "typecheck": "npm run typecheck -w server",
    "build": "npm run build -w server",
    "test": "npm run test -w server",
    "test:unit": "npm run test:unit -w server",
    "test:integration": "npm run test:integration -w server",
    "test:report": "npm run test:report -w server",
    "check:web": "node scripts/engineering/check-web-assets.mjs",
    "check:core": "node scripts/engineering/check-portable-core.mjs",
    "generate:core-vectors": "node scripts/engineering/core-conformance-vectors.mjs",
    "check:core-vectors": "node scripts/engineering/core-conformance-vectors.mjs --check",
    "smoke:server": "node scripts/engineering/smoke-server.mjs",
    "smoke:community": "node scripts/engineering/smoke-community.mjs",
    "smoke:background": "node scripts/engineering/smoke-background-protection.mjs",
    "package:portable": "node scripts/release/build-portable.mjs",
    "verify:package": "node scripts/release/verify-portable.mjs",
    "package:verify": "npm run package:portable && npm run verify:package",
    "audit:inventory": "node scripts/engineering/audit-dependencies.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "gate": "node scripts/engineering/run-gate.mjs",
    "verify": "npm run gate",
    "dev": "npm run dev -w server",
    "dev:community": "npm run dev:community -w server",
    "start": "npm run start -w server",
    "start:community": "npm run start:community -w server"
  }
}
