# Live provider OAuth application configuration belongs in .env.local.
# Never commit real OAuth credentials. The Microsoft guided desktop flow is a
# public client and must not have a client secret.
EMAIL_SHIELD_GOOGLE_CLIENT_ID=
EMAIL_SHIELD_GOOGLE_CLIENT_SECRET=
EMAIL_SHIELD_MICROSOFT_CLIENT_ID=

# Email Shield technical telemetry is disabled by default.
EMAIL_SHIELD_TELEMETRY=0
EMAIL_SHIELD_POSTHOG_PROJECT_TOKEN=
EMAIL_SHIELD_POSTHOG_HOST=https://us.i.posthog.com
EMAIL_SHIELD_RELEASE_VERSION=0.2.0
