{
  "name": "@email-shield/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env.local --import tsx src/index.ts",
    "dev:community": "tsx src/communityIndex.ts",
    "dev:account-service": "tsx src/accountServiceIndex.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run tests/unit",
    "test:capacity": "vitest run tests/capacity",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:report": "npm run build && vitest run --reporter=json --outputFile=../test-report.json && vitest run",
    "ops:community": "npm run build && node dist/communityOps.js",
    "recover:local-state": "npm run build && node dist/devtools/localStateRecoveryCli.js",
    "start": "node dist/index.js",
    "start:community": "node dist/communityIndex.js",
    "start:account-service": "node dist/accountServiceIndex.js"
  },
  "dependencies": {
    "@azure/msal-node": "^5.5.0",
    "@googleapis/gmail": "^18.0.0",
    "express": "^4.19.2",
    "google-auth-library": "^10.5.0",
    "imapflow": "^1.6.5",
    "jpeg-js": "0.4.4",
    "jsqr": "1.4.0",
    "mailparser": "^3.9.14",
    "pngjs": "7.0.0",
    "tldts": "7.4.9"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/imapflow": "^1.0.23",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
